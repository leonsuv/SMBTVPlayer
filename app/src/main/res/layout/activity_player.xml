<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Built-in controller animations assume Media3's stock layout, so they're off;
         PlayerActivity fades the custom controller in and out instead. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:animation_enabled="false"
        app:controller_layout_id="@layout/player_controls"
        app:pause_icon="@drawable/ic_pause"
        app:play_icon="@drawable/ic_play"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:show_timeout="4000"
        app:shutter_background_color="#FF000000" />

    <include
        layout="@layout/view_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="40dp" />

    <!-- Quick-seek indicator shown when Left/Right are used with the controller hidden. -->
    <LinearLayout
        android:id="@+id/seek_indicator"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:alpha="0"
        android:background="@drawable/seek_pill"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="16dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/seek_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_forward"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/seek_delta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/seek_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/seek_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:progressDrawable="@drawable/seek_progress" />
    </LinearLayout>
</FrameLayout>
